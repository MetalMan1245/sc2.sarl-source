---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Changelog | ${SITE_TITLE}`} description="Recent changes to the Metalverse website." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Website Changelog</h1>
			<p>Recent website updates, parsed from the project’s public GitHub commit history.</p>
			<p id="changelog-status" aria-live="polite">Loading recent changes…</p>
			<ol id="changelog-entries" class="changelog-entries"></ol>
			<p>
				<a
					href="https://github.com/MetalMan1245/sc2.sarl-source/commits/master"
					target="_blank"
					rel="noopener noreferrer">View the complete commit history on GitHub</a
				>
			</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	interface CommitRecord {
		sha: string;
		message: string;
		date: string;
	}

	function isRecord(value: unknown): value is Record<string, unknown> {
		return typeof value === 'object' && value !== null;
	}

	function parseCommits(value: unknown): CommitRecord[] {
		if (!Array.isArray(value)) {
			throw new Error('GitHub returned an unexpected changelog response.');
		}

		return value.map((item: unknown) => {
			if (!isRecord(item) || typeof item.sha !== 'string' || !/^[a-f0-9]{7,40}$/i.test(item.sha)) {
				throw new Error('GitHub returned an invalid commit entry.');
			}
			if (!isRecord(item.commit) || typeof item.commit.message !== 'string' || !isRecord(item.commit.author)) {
				throw new Error('GitHub returned an invalid commit description.');
			}
			const date = item.commit.author.date;
			if (typeof date !== 'string' || Number.isNaN(Date.parse(date))) {
				throw new Error('GitHub returned an invalid commit date.');
			}

			return { sha: item.sha, message: item.commit.message, date };
		});
	}

	const status = document.querySelector<HTMLParagraphElement>('#changelog-status');
	const entries = document.querySelector<HTMLOListElement>('#changelog-entries');

	if (status && entries) {
		try {
			const response = await fetch(
				'https://api.github.com/repos/MetalMan1245/sc2.sarl-source/commits?sha=master&per_page=10',
				{ headers: { Accept: 'application/vnd.github+json' } },
			);
			if (!response.ok) {
				throw new Error(`GitHub returned HTTP ${response.status}.`);
			}

			const commits = parseCommits(await response.json());
			if (commits.length === 0) {
				throw new Error('GitHub did not return any commits.');
			}

			const dateFormatter = new Intl.DateTimeFormat(undefined, {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			});
			for (const commit of commits) {
				const item = document.createElement('li');
				const heading = document.createElement('h2');
				const link = document.createElement('a');
				const date = document.createElement('time');
				const [summary, ...descriptionLines] = commit.message.split('\n');
				const description = descriptionLines.join('\n').trim();

				link.href = `https://github.com/MetalMan1245/sc2.sarl-source/commit/${commit.sha}`;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
				link.textContent = summary;
				heading.append(link);
				date.dateTime = commit.date;
				date.textContent = dateFormatter.format(new Date(commit.date));
				item.append(heading, date);
				if (description) {
					const descriptionElement = document.createElement('p');
					descriptionElement.className = 'description';
					descriptionElement.textContent = description;
					item.append(descriptionElement);
				}
				entries.append(item);
			}
			status.remove();
		} catch (error) {
			status.textContent =
				error instanceof Error
					? `Recent changes could not be loaded: ${error.message}`
					: 'Recent changes could not be loaded. Use the full commit history link below.';
		}
	}
</script>

<style>
	main {
		width: 800px;
	}

	.changelog-entries {
		display: grid;
		gap: 0.75em;
		margin: 1.5em 0;
		padding: 0;
		list-style: none;
	}

	.changelog-entries li {
		padding: 1em 1.25em;
		border-left: 4px solid var(--accent);
		border-radius: 0 8px 8px 0;
		background: white;
		box-shadow: 0 2px 6px rgba(var(--gray), 15%);
	}

	.changelog-entries h2 {
		margin: 0 0 0.25em;
		font-size: 1.1em;
	}

	.changelog-entries a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}

	.changelog-entries a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.changelog-entries time {
		color: rgb(var(--gray));
		font-size: 0.8em;
	}

	.changelog-entries .description {
		margin: 0.5em 0 0;
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
		white-space: pre-line;
	}
</style>
