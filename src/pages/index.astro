---
import logo from '../assets/metalman1245-logo.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="welcome-heading">
				<img src={logo.src} alt="" width="64" height="64" />
				Welcome!
			</h1>
			<p>
				My name is Malachi.  Or on the internet known as MetalMan1245.  I'm an audio engineer, voice actor, (amateur) programmer, content creater, tecnician, I do too many things for my own good, honestly.
			</p>
			<p>
				This is the best place to keep up with what I'm doing, what projects I have published, on the backburner, or if you'd like to get in contact with me.
			</p>
			<p>
				In the meantime, check out my GitHub (programming projects), YouTube (Videos), Bandcamp (Music), and Casting Call Club (Voice Acting) links or Contact me.
			</p>
		</main>
		<Footer />
	</body>
</html>
<style>
	.welcome-heading {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}

	.welcome-heading img {
		width: 1em;
		height: 1em;
		border-radius: 0;
		object-fit: contain;
	}
</style>
